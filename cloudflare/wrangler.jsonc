{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "taxiconnect-api",
  "main": "src/index.js",
  "compatibility_date": "2026-09-15",
  "assets": {
    "directory": "../public"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "taxiconnect",
      "database_id": "b0f13180-40c2-4ddc-bc58-d3532f531b36"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "DISPATCH",
        "class_name": "DispatchRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "DispatchRoom"
      ]
    }
  ],
  "vars": {
    "APP_ENV": "development"
  }
}
