{
  "rules": {
    "taxis": {
      ".indexOn": ["route", "status", "driverId"],
      ".read": "auth != null",
      "$taxiId": {
        ".write": "auth != null && auth.token.isConductor === true",
        ".validate": "!newData.exists() || (newData.hasChildren(['driverId','driverName','route','capacity','passengersOnboard','status','lastUpdated']) && newData.child('driverId').isString() && (newData.child('route').val() === 'SUN_CITY' || newData.child('route').val() === 'RUSTENBURG') && newData.child('capacity').isNumber() && newData.child('capacity').val() >= 1 && newData.child('capacity').val() <= 22 && newData.child('passengersOnboard').isNumber() && newData.child('passengersOnboard').val() >= 0 && newData.child('passengersOnboard').val() <= newData.child('capacity').val() && newData.child('status').val().matches(/^(loading|full|departed|breakdown)$/))"
      }
    },

    "waitingPassengers": {
      ".indexOn": ["route", "timestamp", "passengerId"],
      ".read": "auth != null",
      "$waitId": {
        ".write": "auth != null && auth.token.isConductor === true",
        ".validate": "!newData.exists() || (newData.hasChildren(['route','groupSize','timestamp','passengerId']) && newData.child('passengerId').isString() && (newData.child('route').val() === 'SUN_CITY' || newData.child('route').val() === 'RUSTENBURG') && newData.child('groupSize').isNumber() && newData.child('groupSize').val() >= 1 && newData.child('groupSize').val() <= 10)"
      }
    },

    "summons": {
      ".read": "auth != null && (auth.token.isDriver === true || auth.token.isConductor === true)",
      "$route": {
        ".write": "auth != null && auth.token.isConductor === true",
        ".validate": "!newData.exists() || newData.hasChildren(['count','timestamp','conductorId'])"
      }
    },

    "summonRequests": {
      ".read": "auth != null && (auth.token.isConductor === true || auth.token.isDriver === true)",
      ".write": "auth != null && auth.token.isConductor === true"
    },

    "demandHeatmap": {
      ".read": "auth != null && auth.token.isConductor === true",
      "$route": {
        ".write": "auth != null && auth.token.isConductor === true",
        ".validate": "!newData.exists() || (newData.hasChildren(['count','lastUpdated']) && newData.child('count').isNumber() && newData.child('count').val() >= 0)"
      }
    },

    "history": {
      ".read": "auth != null && auth.token.isConductor === true",
      ".write": false
    },

    "users": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || auth.token.isConductor === true)",
        ".write": "auth != null && auth.token.isConductor === true"
      }
    },

    "conductors": {
      "$conductorId": {
        ".read": "auth != null && auth.token.isConductor === true",
        ".write": "auth != null && auth.uid === $conductorId"
      }
    },

    "drivers": {
      "$driverId": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $driverId"
      }
    },

    "activeViewers": {
      ".read": "auth != null",
      "$taxiId": {
        ".write": "auth != null",
        "$uid": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.isBoolean()"
        }
      }
    },

    "announcements": {
      ".read": "auth != null",
      ".indexOn": ["village", "expires"],
      "$announcementId": {
        ".write": "auth != null && auth.token.isConductor === true",
        ".validate": "!newData.exists() || newData.hasChildren(['conductorId','message','timestamp','expires'])"
      }
    },

    "passengerPreferences": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },

    "approvedPhones": {
      ".read": false,
      ".write": "auth != null && auth.token.isConductor === true"
    }
  }
}
